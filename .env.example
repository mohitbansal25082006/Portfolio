EMAIL_USER=yourgmailaddress@gmail.com
EMAIL_PASS=your16digitapppassword

GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_USERNAME=your-username

# ── Messages / Storage (Part 2.2) ────────────────────────────────────────────
# Vercel KV (Upstash Redis) — Vercel injects these automatically when you
# link a KV store to your project. Copy them here for local dev too.
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your-read-write-token-here

# Optional: override the local JSON file path (dev only, no KV needed)
# MESSAGES_FILE=/absolute/path/to/messages.json

# ── Admin Dashboard (Part 2.1) ────────────────────────────────────────────────
# Secret used to sign session tokens. Must be at least 16 random characters.
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret

# Add as many admin accounts as needed (ADMIN_MAIL1, ADMIN_MAIL2, … etc.)
ADMIN_MAIL1=admin@example.com
ADMIN_PASSWORD1=your-strong-password

# ADMIN_MAIL2=second@example.com
# ADMIN_PASSWORD2=second-password

# ── Analytics (Part 2.3) ──────────────────────────────────────────────────────
# Vercel personal access token — create at https://vercel.com/account/tokens
VERCEL_API_TOKEN=your-vercel-personal-access-token

# Project ID — Vercel Dashboard → your project → Settings → General → Project ID
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Team ID — only required if the project belongs to a Vercel team
# VERCEL_TEAM_ID=team_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Resume Management (Part 2.4) ──────────────────────────────────────────────
# Vercel Blob — Vercel injects this automatically when you connect a Blob
# store to your project (Vercel Dashboard → Storage → Create Database → Blob).
# Required in production for resume uploads to persist across deployments.
# Without it, uploads fall back to writing /public/resume.pdf locally (dev only).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Used by the resume download-tracking route as a fallback base URL if the
# metadata store is unreachable. Set to your production domain.
NEXT_PUBLIC_SITE_URL=https://your-portfolio-domain.com